{
  "expo": {
    "name": "Lockspot",
    "slug": "lockspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockspot",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d09c6bc7-1fbb-40be-a0a7-c1fa8d052bc6"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eee6db",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eee6db",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00BF5E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lockspot utilise la biométrie pour que toi seul puisses ouvrir tes coffres."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lockspot vérifie ta position pour s'assurer que tu es bien à l'endroit où tu as posé ton coffre.",
          "locationAlwaysAndWhenInUsePermission": "Lockspot utilise ta position en arrière-plan pour te prévenir quand tu arrives près d'un de tes coffres.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lockspot accède à tes photos pour que tu puisses les ranger dans un coffre.",
          "cameraPermission": "Lockspot utilise l'appareil photo pour ajouter des photos à tes coffres.",
          "microphonePermission": false
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d09c6bc7-1fbb-40be-a0a7-c1fa8d052bc6"
      }
    },
    "owner": "vadanero"
  }
}